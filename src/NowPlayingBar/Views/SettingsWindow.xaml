<Window x:Class="NowPlayingBar.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Şimdi Çalıyor — Ayarlar"
        Width="500"
        Height="680"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#0D121A"
        Foreground="#FFFFFF"
        FontFamily="Segoe UI Variable, Segoe UI">

    <Window.Resources>
        <!-- Modern Card Style matching widget -->
        <Style x:Key="ModernSettingCard" TargetType="Border">
            <Setter Property="Background" Value="#151D2A"/>
            <Setter Property="BorderBrush" Value="#223044"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16,12,16,12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- Modern Dark TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0F1622"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="CaretBrush" Value="#38BDF8"/>
            <Setter Property="BorderBrush" Value="#2D3E56"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6,10,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#38BDF8"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#38BDF8"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Slider Style -->
        <Style TargetType="Slider">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Modern Dark CheckBox -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,4,0,6"/>
        </Style>

        <!-- Primary Action Button -->
        <Style x:Key="DoneButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#0284C7"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="24,8,24,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#0369A1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#075985"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="22,18,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Widget Ayarları" FontSize="22" FontWeight="SemiBold" Foreground="#F8FAFC"/>
            <TextBlock Text="Değişiklikler görev çubuğunda anlık ve canlı olarak uygulanır." FontSize="12" Foreground="#94A3B8" Margin="0,3,0,0"/>
        </StackPanel>

        <!-- Scrollable Settings -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,-8,14" Padding="0,0,8,0">
            <StackPanel>

                <!-- Section 1: Konum ve Ölçüler -->
                <TextBlock Text="KONUM VE BOYUT" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" Margin="2,0,0,8"/>

                <!-- Yatay Ofset (X) -->
                <Border Style="{StaticResource ModernSettingCard}">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Yatay Konum (Ofset X)" FontSize="13" FontWeight="SemiBold" Foreground="#F1F5F9"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBox x:Name="TxtOffsetX" Width="60" Text="270" HorizontalContentAlignment="Right" Padding="4,2,4,2" FontSize="12" Margin="0,0,4,0" TextChanged="OnOffsetXTextChanged"/>
                                <TextBlock Text="px" FontSize="12" Foreground="#38BDF8" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Görev çubuğunun sağ kenarından/saat alanından olan uzaklık" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,8"/>
                        <Slider x:Name="SliderOffsetX" Minimum="-500" Maximum="3000" Value="270" ValueChanged="OnLiveSliderChanged"/>
                    </StackPanel>
                </Border>

                <!-- Dikey Ofset (Y) -->
                <Border Style="{StaticResource ModernSettingCard}">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Dikey Konum (Ofset Y)" FontSize="13" FontWeight="SemiBold" Foreground="#F1F5F9"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBox x:Name="TxtOffsetY" Width="60" Text="0" HorizontalContentAlignment="Right" Padding="4,2,4,2" FontSize="12" Margin="0,0,4,0" TextChanged="OnOffsetYTextChanged"/>
                                <TextBlock Text="px" FontSize="12" Foreground="#38BDF8" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Dikey hassas ayar (- yukarı, + aşağı kaydırır)" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,8"/>
                        <Slider x:Name="SliderOffsetY" Minimum="-200" Maximum="200" Value="0" ValueChanged="OnLiveSliderChanged"/>
                    </StackPanel>
                </Border>

                <!-- Genişlik (MaxWidth) -->
                <Border Style="{StaticResource ModernSettingCard}">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Widget Genişliği" FontSize="13" FontWeight="SemiBold" Foreground="#F1F5F9"/>
                            <TextBlock x:Name="LblMaxWidth" Grid.Column="1" Text="380 px" FontSize="12" Foreground="#38BDF8" FontWeight="SemiBold"/>
                        </Grid>
                        <TextBlock Text="Kapsülün toplam piksel uzunluğu" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,8"/>
                        <Slider x:Name="SliderMaxWidth" Minimum="180" Maximum="1200" Value="380" ValueChanged="OnLiveSliderChanged"/>
                    </StackPanel>
                </Border>

                <!-- Yazı Boyutu -->
                <Border Style="{StaticResource ModernSettingCard}">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Yazı Boyutu" FontSize="13" FontWeight="SemiBold" Foreground="#F1F5F9"/>
                            <TextBlock x:Name="LblFontSize" Grid.Column="1" Text="13 pt" FontSize="12" Foreground="#38BDF8" FontWeight="SemiBold"/>
                        </Grid>
                        <TextBlock Text="Şarkı adı ve sanatçı yazı boyutu" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,8"/>
                        <Slider x:Name="SliderFontSize" Minimum="10" Maximum="18" Value="13" ValueChanged="OnLiveSliderChanged"/>
                    </StackPanel>
                </Border>

                <!-- Kayan Yazı Hızı -->
                <Border Style="{StaticResource ModernSettingCard}">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Kayan Yazı Hızı (Marquee)" FontSize="13" FontWeight="SemiBold" Foreground="#F1F5F9"/>
                            <TextBlock x:Name="LblMarqueeSpeed" Grid.Column="1" Text="30 px/sn" FontSize="12" Foreground="#38BDF8" FontWeight="SemiBold"/>
                        </Grid>
                        <TextBlock Text="Yazı alana sığmadığında otomatik kayma hızı" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,8"/>
                        <Slider x:Name="SliderMarqueeSpeed" Minimum="10" Maximum="80" Value="30" ValueChanged="OnLiveSliderChanged"/>
                    </StackPanel>
                </Border>

                <!-- Metin Formatı -->
                <Border Style="{StaticResource ModernSettingCard}">
                    <StackPanel>
                        <TextBlock Text="Metin Formatı" FontSize="13" FontWeight="SemiBold" Foreground="#F1F5F9"/>
                        <TextBlock Text="Kullanabileceğiniz etiketler: {artist}, {title}, {album}" FontSize="11" Foreground="#94A3B8" Margin="0,1,0,8"/>
                        <TextBox x:Name="TxtFormat" Text="{}{artist} - {title}" TextChanged="OnLiveTextChanged"/>
                    </StackPanel>
                </Border>

                <!-- Section 2: Kısayol Tuşları -->
                <TextBlock Text="KISA YOL TUŞLARI" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" Margin="2,14,0,8"/>

                <Border Style="{StaticResource ModernSettingCard}">
                    <StackPanel>
                        <TextBlock Text="Oynat / Duraklat" FontSize="13" FontWeight="SemiBold" Foreground="#F1F5F9" Margin="0,0,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="HotkeyBoxPlayPause"
                                    Background="#0F1622" BorderBrush="#2D3E56" BorderThickness="1"
                                    CornerRadius="6" Padding="10,6" Cursor="Hand"
                                    MouseLeftButtonDown="OnHotkeyBoxClicked" Tag="PlayPause">
                                <TextBlock x:Name="HotkeyLblPlayPause" Text="Atanmamış" Foreground="#94A3B8" FontSize="12"/>
                            </Border>
                            <Button Grid.Column="1" Content="✕" Width="28" Height="28" Margin="6,0,0,0"
                                    Style="{StaticResource DoneButtonStyle}" Padding="0"
                                    Background="#374151" Click="OnHotkeyClear" Tag="PlayPause"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ModernSettingCard}">
                    <StackPanel>
                        <TextBlock Text="Sonraki Parça" FontSize="13" FontWeight="SemiBold" Foreground="#F1F5F9" Margin="0,0,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="HotkeyBoxNext"
                                    Background="#0F1622" BorderBrush="#2D3E56" BorderThickness="1"
                                    CornerRadius="6" Padding="10,6" Cursor="Hand"
                                    MouseLeftButtonDown="OnHotkeyBoxClicked" Tag="Next">
                                <TextBlock x:Name="HotkeyLblNext" Text="Atanmamış" Foreground="#94A3B8" FontSize="12"/>
                            </Border>
                            <Button Grid.Column="1" Content="✕" Width="28" Height="28" Margin="6,0,0,0"
                                    Style="{StaticResource DoneButtonStyle}" Padding="0"
                                    Background="#374151" Click="OnHotkeyClear" Tag="Next"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ModernSettingCard}">
                    <StackPanel>
                        <TextBlock Text="Önceki Parça" FontSize="13" FontWeight="SemiBold" Foreground="#F1F5F9" Margin="0,0,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="HotkeyBoxPrevious"
                                    Background="#0F1622" BorderBrush="#2D3E56" BorderThickness="1"
                                    CornerRadius="6" Padding="10,6" Cursor="Hand"
                                    MouseLeftButtonDown="OnHotkeyBoxClicked" Tag="Previous">
                                <TextBlock x:Name="HotkeyLblPrevious" Text="Atanmamış" Foreground="#94A3B8" FontSize="12"/>
                            </Border>
                            <Button Grid.Column="1" Content="✕" Width="28" Height="28" Margin="6,0,0,0"
                                    Style="{StaticResource DoneButtonStyle}" Padding="0"
                                    Background="#374151" Click="OnHotkeyClear" Tag="Previous"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ModernSettingCard}">
                    <StackPanel>
                        <TextBlock Text="Widget'ı Gizle / Göster" FontSize="13" FontWeight="SemiBold" Foreground="#F1F5F9" Margin="0,0,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="HotkeyBoxToggle"
                                    Background="#0F1622" BorderBrush="#2D3E56" BorderThickness="1"
                                    CornerRadius="6" Padding="10,6" Cursor="Hand"
                                    MouseLeftButtonDown="OnHotkeyBoxClicked" Tag="Toggle">
                                <TextBlock x:Name="HotkeyLblToggle" Text="Atanmamış" Foreground="#94A3B8" FontSize="12"/>
                            </Border>
                            <Button Grid.Column="1" Content="✕" Width="28" Height="28" Margin="6,0,0,0"
                                    Style="{StaticResource DoneButtonStyle}" Padding="0"
                                    Background="#374151" Click="OnHotkeyClear" Tag="Toggle"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Section 3: Davranış ve Seçenekler -->
                <TextBlock Text="DAVRANIŞ VE SEÇENEKLER" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" Margin="2,14,0,8"/>
                <Border Style="{StaticResource ModernSettingCard}">
                    <StackPanel>
                        <CheckBox x:Name="ChkShowAlbumArt" Content="Albüm kapağı görselini göster (Banner)" Checked="OnLiveOptionChanged" Unchecked="OnLiveOptionChanged"/>
                        <CheckBox x:Name="ChkShowOnlyWhenPlaying" Content="Sadece müzik çalarken göster (Duraklatılınca gizle)" Checked="OnLiveOptionChanged" Unchecked="OnLiveOptionChanged"/>
                        <CheckBox x:Name="ChkClickThrough" Content="Tıklama geçirgenliği (Fare tıklamalarını arkaya geçir)" Checked="OnLiveOptionChanged" Unchecked="OnLiveOptionChanged"/>
                        <CheckBox x:Name="ChkCleanYoutube" Content="YouTube gereksiz takılarını temizle (' - YouTube' vb.)" Checked="OnLiveOptionChanged" Unchecked="OnLiveOptionChanged"/>
                        <CheckBox x:Name="ChkVolumeScroll" Content="Fare tekerleği ile ses seviyesini ayarla (Yukarı / Aşağı kaydırma)" Checked="OnLiveOptionChanged" Unchecked="OnLiveOptionChanged"/>
                        <CheckBox x:Name="ChkStartWithWindows" Content="Windows ile birlikte otomatik başlat" Checked="OnLiveOptionChanged" Unchecked="OnLiveOptionChanged"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Bottom Action -->
        <Border Grid.Row="2" Padding="0,10,0,0" BorderThickness="0,1,0,0" BorderBrush="#1C2738">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Tamam" IsDefault="True" Click="OnDoneClick" Style="{StaticResource DoneButtonStyle}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
