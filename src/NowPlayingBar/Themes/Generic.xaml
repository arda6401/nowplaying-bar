<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:NowPlayingBar.Views">

    <Style TargetType="{x:Type views:MarqueeTextBlock}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type views:MarqueeTextBlock}">
                    <Canvas x:Name="PART_Canvas" ClipToBounds="True">
                        <TextBlock x:Name="PART_TextBlock"
                                   Text="{TemplateBinding Text}"
                                   Foreground="{TemplateBinding TextBrush}"
                                   FontSize="{TemplateBinding FontSize}"
                                   FontFamily="{TemplateBinding FontFamily}"
                                   FontWeight="{TemplateBinding FontWeight}"
                                   VerticalAlignment="Center"
                                   Canvas.Top="0"
                                   Canvas.Left="0"/>
                    </Canvas>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
